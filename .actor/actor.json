{
    "actorSpecification": 1,
    "name": "workday-job-search",
    "title": "Workday Jobs Scraper & API - All Companies, Last 24 Hours",
    "description": "Workday jobs scraper and API for every company on myworkdayjobs.com, searched live by job title, location, remote and posting date, newest first. 1,688 employers, 659,000+ open jobs, no company list needed. The site:myworkdayjobs.com dork done at the source: full descriptions, dead-link checks.",
    "version": "1.0",
    "buildTag": "latest",
    "categories": [
        "JOBS",
        "LEAD_GENERATION",
        "OPEN_SOURCE"
    ],
    "input": "./INPUT_SCHEMA.json",
    "output": "./output_schema.json",
    "dockerfile": "../Dockerfile",
    "readme": "../README.md",
    "minMemoryMbytes": 512,
    "maxMemoryMbytes": 4096,
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Workday jobs",
            "description": "One row per job, newest first: title, company, locations, work type, job type, pay, posting date and links; with details on, also the description, salary numbers and address. The run summary is the OUTPUT record, not a row.",
            "fields": {
                "type": "object",
                "properties": {
                    "title": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job title (title)",
                        "description": "The job title as the company wrote it on Workday.",
                        "example": "Federal Program Director"
                    },
                    "company": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Company name (company)",
                        "description": "The company. Workday publishes only the name in the address, so names are written by hand for the big employers and read from the address for the rest.",
                        "example": "NVIDIA"
                    },
                    "location": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Main location (location)",
                        "description": "The job's main place as Workday shows it. Without details a job in several places says 2 Locations.",
                        "example": "US, DC, Remote"
                    },
                    "otherLocations": {
                        "type": [
                            "array",
                            "null"
                        ],
                        "title": "Other locations (otherLocations)",
                        "description": "Every other place the job is posted for, with details on.",
                        "example": [
                            "US, CA, Santa Clara"
                        ],
                        "items": {
                            "type": "string"
                        }
                    },
                    "workType": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Remote or onsite (workType)",
                        "description": "Remote or hybrid when the title or location says so, or Workday's own field with details on; empty when neither does.",
                        "example": "remote"
                    },
                    "postedAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Posted on (postedAt)",
                        "description": "The day the job was posted. Workday's list stops at 30 days: older jobs are empty without details.",
                        "example": "2026-10-30"
                    },
                    "jobUrl": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job link (jobUrl)",
                        "description": "The job's page on the company's Workday board.",
                        "example": "https://nvidia.wd5.myworkdayjobs.com/NVIDIAExternalCareerSite/job/US-DC-Remote/Federal-Program-Director_JR2027714"
                    },
                    "applyUrl": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Apply link (applyUrl)",
                        "description": "The link to apply.",
                        "example": "https://nvidia.wd5.myworkdayjobs.com/NVIDIAExternalCareerSite/job/US-DC-Remote/Federal-Program-Director_JR2027714"
                    },
                    "status": {
                        "type": "string",
                        "title": "Still open? (status)",
                        "description": "open for every search result (read live from the board during the run). For a checked link: open, closed (no longer on the board) or not found (no such Workday board).",
                        "example": "open"
                    },
                    "companySlug": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Career site (companySlug)",
                        "description": "The career site: the tenant, its Workday server and the site, as in nvidia/wd5/NVIDIAExternalCareerSite.",
                        "example": "nvidia/wd5/NVIDIAExternalCareerSite"
                    },
                    "jobId": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job ID (jobId)",
                        "description": "The job's path on the career site, which is what a job link needs.",
                        "example": "US-DC-Remote/Federal-Program-Director_JR2027714"
                    },
                    "checkedAt": {
                        "type": "string",
                        "title": "Checked at (checkedAt)",
                        "description": "When the run read the boards, in UTC.",
                        "example": "2026-10-30T11:57:07+00:00"
                    },
                    "description": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job description (description)",
                        "description": "The job description as plain text, with details on.",
                        "example": "Lead federal programs across engineering, security and compliance teams."
                    },
                    "descriptionHtml": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Description as HTML (descriptionHtml)",
                        "description": "The job description as the company wrote it in HTML, with details on.",
                        "example": "<p>Lead federal programs across engineering, security and compliance teams.</p>"
                    },
                    "city": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job city (city)",
                        "description": "The city of the job's main place, when stored apart.",
                        "example": "Herentals"
                    },
                    "region": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "State or region (region)",
                        "description": "The state or region of the job's main place, when stored apart.",
                        "example": "PA"
                    },
                    "country": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job country (country)",
                        "description": "The country of the job's main place, with details on.",
                        "example": "United States of America"
                    },
                    "countryCode": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Country code (countryCode)",
                        "description": "The two-letter country code, with details on.",
                        "example": "US"
                    },
                    "expiresAt": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Closes on (expiresAt)",
                        "description": "The last day of the posting, when the company set one.",
                        "example": "2026-11-30"
                    },
                    "platform": {
                        "type": "string",
                        "title": "Job platform (platform)",
                        "description": "The ATS the job came from: always workday here.",
                        "example": "workday"
                    },
                    "reference": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Company's reference (reference)",
                        "description": "The requisition number.",
                        "example": "JR2027714"
                    },
                    "employmentType": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "title": "Job type (employmentType)",
                        "description": "full-time or part-time, with details on.",
                        "example": "full-time"
                    }
                }
            },
            "views": {
                "jobs": {
                    "title": "Jobs",
                    "description": "One row per job: what it is, where, remote or not and when it was posted, with its link.",
                    "transformation": {
                        "fields": [
                            "title",
                            "company",
                            "location",
                            "workType",
                            "postedAt",
                            "jobUrl",
                            "status"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "title": {
                                "label": "Job title (title)",
                                "format": "text"
                            },
                            "company": {
                                "label": "Company name (company)",
                                "format": "text"
                            },
                            "location": {
                                "label": "Main location (location)",
                                "format": "text"
                            },
                            "workType": {
                                "label": "Remote or onsite (workType)",
                                "format": "text"
                            },
                            "postedAt": {
                                "label": "Posted on (postedAt)",
                                "format": "date"
                            },
                            "jobUrl": {
                                "label": "Job link (jobUrl)",
                                "format": "link"
                            },
                            "status": {
                                "label": "Still open? (status)",
                                "format": "text"
                            }
                        }
                    }
                },
                "details": {
                    "title": "Details",
                    "description": "The description, address and every other field of each job.",
                    "transformation": {
                        "fields": [
                            "title",
                            "company",
                            "employmentType",
                            "description",
                            "city",
                            "region",
                            "countryCode",
                            "otherLocations",
                            "applyUrl",
                            "companySlug",
                            "jobId",
                            "checkedAt"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "title": {
                                "label": "Job title (title)",
                                "format": "text"
                            },
                            "company": {
                                "label": "Company name (company)",
                                "format": "text"
                            },
                            "description": {
                                "label": "Job description (description)",
                                "format": "text"
                            },
                            "city": {
                                "label": "Job city (city)",
                                "format": "text"
                            },
                            "region": {
                                "label": "State or region (region)",
                                "format": "text"
                            },
                            "countryCode": {
                                "label": "Country code (countryCode)",
                                "format": "text"
                            },
                            "otherLocations": {
                                "label": "Other locations (otherLocations)",
                                "format": "array"
                            },
                            "applyUrl": {
                                "label": "Apply link (applyUrl)",
                                "format": "link"
                            },
                            "companySlug": {
                                "label": "Career site (companySlug)",
                                "format": "text"
                            },
                            "jobId": {
                                "label": "Job ID (jobId)",
                                "format": "text"
                            },
                            "checkedAt": {
                                "label": "Checked at (checkedAt)",
                                "format": "date"
                            },
                            "employmentType": {
                                "label": "Job type (employmentType)",
                                "format": "text"
                            }
                        }
                    }
                }
            }
        },
        "keyValueStore": {
            "actorKeyValueStoreSchemaVersion": 1,
            "title": "Run summary",
            "description": "The OUTPUT record: how many boards were read and matched, how many jobs matched and were saved, the checked links, the notes about how the input was read and the settings used.",
            "collections": {
                "summary": {
                    "title": "Run summary (OUTPUT)",
                    "description": "Status, message, counts for the boards and jobs, checked links, notes and settings.",
                    "key": "OUTPUT"
                }
            }
        }
    }
}